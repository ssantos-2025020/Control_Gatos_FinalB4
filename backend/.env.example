# Configuración del servidor
PORT=2500

# Cadena de conexión a PostgreSQL (obligatoria)
DATABASE_URL="postgresql://postgres:tu_password@localhost:5432/control_gastos"

# Configuración JWT (obligatoria; el backend no arranca sin ella)
JWT_SECRET=tu_jwt_secret_super_seguro_aqui
JWT_EXPIRES_IN=3h

# Usuario admin que se crea automáticamente al iniciar (opcional)
ADMIN_EMAIL=admin@controlgastos.com
ADMIN_PASSWORD=Admin123!
ADMIN_NOMBRE=Administrador

# Configuración Google OAuth (opcional; si falta se usa el ID de desarrollo)
GOOGLE_CLIENT_ID=879432250502-la0hitfpf8obq59vu6p5f22dsom9hlka.apps.googleusercontent.com